{
  "name": "nonebot-registry",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "build:preview": "vue-tsc && vite build --mode preview",
    "preview": "vite preview",
    "lint": "eslint \"**/*.{js,ts,vue}\"",
    "lint:fix": "eslint --fix \"**/*.{js,ts,vue}\"",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@sentry/vue": "^10.78.0",
    "@vueuse/core": "^15.0.0",
    "ansi_up": "^6.0.6",
    "gsap": "^3.15.0",
    "highlight.js": "^11.12.0",
    "naive-ui": "^2.45.3",
    "pinia": "^3.0.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sentry/vite-plugin": "^5.4.1",
    "@types/node": "^26.6.6",
    "@unocss/eslint-config": "^66.12.0",
    "@unocss/transformer-directives": "^66.12.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.107.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "unocss": "^66.12.0",
    "vite": "^8.3.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "**/*.{js,ts,vue}": [
      "eslint --fix --cache"
    ]
  }
}
